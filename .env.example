# Base64(Client_ID:Client_Secret) from Sber Developers console
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS (individuals) | GIGACHAT_API_B2B (business, prepaid) | GIGACHAT_API_CORP (business, pay-as-you-go)
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# PEM file with the Russian Trusted Root CA (Ministry of Digital Development).
# Needed unless your system already trusts it; there is no bundled fallback.
# Without it requests fail with "unknown certificate verification error".
GIGACHAT_CA_BUNDLE_FILE=
# Set to false only for diagnostics
GIGACHAT_VERIFY_SSL=true
# Optional: new API host announced in the docs (from 2026-07-17); the old host stays available
# GIGACHAT_BASE_URL=https://api.giga.chat/v1
# GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
